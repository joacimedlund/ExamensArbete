@model AlphaWebApp.Models.LoginForm
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Login";
}

<section id="signin">
    <div class="content surface">
        <div class="section-header"><h2>@ViewData["Title"]</h2></div>

        <div class="section-body">
            <form asp-action="Login" asp-controller="Auth" method="post" data-validate="login" novalidate>
                @Html.AntiForgeryToken()

                <div class="error-message">@ViewBag?.ErrorMessage</div>

                <div class="form-group">
                    <label asp-for="Email"></label>
                    <div class="field-group">
                        <input asp-for="Email" type="email" required autofocus />
                        <span asp-validation-for="Email"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Password"></label>
                    <div class="field-group">
                        <input asp-for="Password" type="password" required />
                        <span asp-validation-for="Password"></span>
                    </div>
                </div>


                <button type="submit" class="btn btn-blue btn-submit">Sign in</button>
            </form>
        </div>

        <div class="section-footer">
            <span>Don't have an account?</span>
            <a asp-action="Register" asp-controller="Auth">Create account</a>
        </div>
    </div>
</section>
