@using ProjectFlowWebApp.Data.Enums
@model ProjectFlowWebApp.Models.EditProjectForm

<div id="editProjectModal-@Model.Id" class="modal">
    <div class="modal-content">
        <header class="modal-header">
            <h3>Edit Project</h3>
            <button data-close="true" data-target="#editProjectModal-@Model.Id" type="button" class="btn-close"></button>
        </header>

        <div class="modal-logotype">
            <img src="~/Images/project-logotype.svg" />
        </div>

        <main class="modal-body">

            <form method="post" action="/projects/edit-ajax"
              class="ajax" novalidate data-failmsg="Unable to update project">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="ProjectName"></label>
                <div class="field-group">
                    <input asp-for="ProjectName" />
                    <span asp-validation-for="ProjectName"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="ClientName"></label>
                <div class="field-group">
                    <input asp-for="ClientName" />
                    <span asp-validation-for="ClientName"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Description"></label>
                <div class="field-group">
                        <textarea asp-for="Description" rows="3" ></textarea>
                    <span asp-validation-for="Description"></span>
                </div>
            </div>
                <div class="form-row two">
                    <div class="form-group">
                        <label asp-for="StartDate"></label>
                        <div class="field-group date-field">
                            <input asp-for="StartDate" type="date" />                       
                        </div>
                        <span asp-validation-for="StartDate"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="EndDate"></label>
                        <div class="field-group date-field">
                            <input asp-for="EndDate" type="date" />                          
                        </div>
                        <span asp-validation-for="EndDate"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Status"></label>
                    <div class="field-group">
                        <select asp-for="Status"
                                asp-items="Html.GetEnumSelectList<ProjectStatus>()"></select>
                    </div>
                    <span asp-validation-for="Status"></span>
                </div>

            <div class="form-group">
                <label asp-for="Budget"></label>
                <div class="field-group">
                    <input asp-for="Budget" type="number" step="0.01" inputmode="decimal" />
                    <span asp-validation-for="Budget"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-blue btn-submit">Save</button>
        </form>

        </main>
    </div>
</div>