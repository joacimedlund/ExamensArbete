<aside>
    <a asp-controller="Dashboard" asp-action="Index" class="brand-link">
        <img src="~/Images/projectFlow.png" alt="ProjectFlow Logotype" />
    </a>

    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    }

    <nav class="nav-links">
        <a asp-action="Index" asp-controller="Dashboard" class="nav-link @(currentController == "Dashboard" ? "active" : "")">
            <i class="bi bi-grid-1x2"></i> Dashboard
        </a>

        <a asp-action="Index" asp-controller="Projects" class="nav-link @(currentController == "Projects" || currentController == "ProjectAdd" ? "active" : "")">
            <i class="bi bi-briefcase"></i> Projects
        </a>
    </nav>
</aside>
