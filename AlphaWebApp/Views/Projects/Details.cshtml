@using AlphaWebApp.Data.Enums
@model AlphaWebApp.Models.ViewModels.ProjectDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

<section id="project-details">
    <header class="page-headline">
        <div>
            <a asp-controller="Projects" asp-action="Index" class="back-link">Back to projects</a>
            <h2>@Model.Name</h2>
            <p class="page-subtitle">@Model.Client</p>
        </div>
        <span class="status-pill">@Model.Status</span>
    </header>

    <div class="details-grid">
        <article class="details-panel">
            <h3>Project summary</h3>
            <p class="description">
                @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)
            </p>
        </article>

        <aside class="details-panel project-facts">
            <h3>Details</h3>
            <dl>
                <div>
                    <dt>Start date</dt>
                    <dd>@(Model.StartDate?.ToString("yyyy-MM-dd") ?? "Not set")</dd>
                </div>
                <div>
                    <dt>End date</dt>
                    <dd>@(Model.EndDate?.ToString("yyyy-MM-dd") ?? "Not set")</dd>
                </div>
                <div>
                    <dt>Budget</dt>
                    <dd>@(Model.Budget.HasValue ? $"{Model.Budget.Value:0.##} kr" : "Not set")</dd>
                </div>
            </dl>
        </aside>
    </div>

    <section class="details-panel tasks-panel">
        <header class="section-title">
            <h3>Tasks</h3>
            <span class="status-pill">@Model.Tasks.Count total</span>
        </header>

        <form asp-controller="Tasks" asp-action="Create" method="post" class="task-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="AddTaskForm.ProjectId" name="ProjectId" />

            <div class="task-form-main">
                <div class="field-group">
                    <input asp-for="AddTaskForm.Title" name="Title" maxlength="200" placeholder="New task title" required />
                    <span asp-validation-for="AddTaskForm.Title"></span>
                </div>
                <div class="field-group">
                    <input asp-for="AddTaskForm.DueDate" name="DueDate" type="date" />
                </div>
                <div class="field-group">
                    <select asp-for="AddTaskForm.Priority"
                            name="Priority"
                            asp-items="Html.GetEnumSelectList<TaskPriority>()"></select>
                </div>
                <button type="submit" class="btn btn-blue">Add Task</button>
            </div>

            <textarea asp-for="AddTaskForm.Description"
                      name="Description"
                      rows="2"
                      maxlength="2000"
                      placeholder="Optional description"></textarea>
        </form>

        @if (Model.Tasks.Any())
        {
            <div class="task-list">
                @foreach (var task in Model.Tasks)
                {
                    var editForm = new EditTaskForm
                    {
                        Id = task.Id,
                        ProjectId = task.ProjectId,
                        Title = task.Title,
                        Description = task.Description,
                        DueDate = task.DueDate,
                        Status = task.Status,
                        Priority = task.Priority
                    };

                    <article class="task-item @(task.Status == AlphaWebApp.Data.Enums.TaskStatus.Done ? "is-done" : "")">
                        <div class="task-item-summary">
                            <div>
                                <h4>@task.Title</h4>
                                @if (!string.IsNullOrWhiteSpace(task.Description))
                                {
                                    <p>@task.Description</p>
                                }
                                <div class="task-meta">
                                    <span class="status-pill">@task.Status</span>
                                    <span class="priority-pill priority-@task.Priority.ToString().ToLower()">@task.Priority</span>
                                    <span>@(task.DueDate?.ToString("yyyy-MM-dd") ?? "No due date")</span>
                                </div>
                            </div>

                            <div class="task-actions">
                                @if (task.Status != AlphaWebApp.Data.Enums.TaskStatus.Done)
                                {
                                    <form asp-controller="Tasks" asp-action="Complete" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@task.Id" />
                                        <button type="submit" class="btn btn-compact">Done</button>
                                    </form>
                                }
                                <form asp-controller="Tasks" asp-action="Delete" method="post"
                                      onsubmit="return confirm('Delete this task?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@task.Id" />
                                    <button type="submit" class="btn btn-compact btn-danger">Delete</button>
                                </form>
                            </div>
                        </div>

                        <details class="task-edit">
                            <summary>Edit task</summary>
                            <form asp-controller="Tasks" asp-action="Edit" method="post" class="task-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="Id" value="@editForm.Id" />
                                <input type="hidden" name="ProjectId" value="@editForm.ProjectId" />

                                <div class="task-form-main">
                                    <input name="Title" value="@editForm.Title" maxlength="200" required />
                                    <input name="DueDate" value="@editForm.DueDate?.ToString("yyyy-MM-dd")" type="date" />
                                    <select name="Status">
                                        @foreach (var status in Enum.GetValues<AlphaWebApp.Data.Enums.TaskStatus>())
                                        {
                                            <option value="@((int)status)" selected="@(status == editForm.Status ? "selected" : null)">@status</option>
                                        }
                                    </select>
                                    <select name="Priority">
                                        @foreach (var priority in Enum.GetValues<TaskPriority>())
                                        {
                                            <option value="@((int)priority)" selected="@(priority == editForm.Priority ? "selected" : null)">@priority</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-blue">Save</button>
                                </div>

                                <textarea name="Description" rows="2" maxlength="2000">@editForm.Description</textarea>
                            </form>
                        </details>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="empty-state">No tasks yet. Add the first task above.</div>
        }
    </section>
</section>
